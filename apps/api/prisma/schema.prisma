generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeStatus {
  active
  onboarding
  offboarding
  resigned
}

enum ApprovalStatus {
  draft
  pending
  approved
  rejected
  cancelled
}

enum PostScope {
  company
  department
  group
  private
}

enum AttendanceStatus {
  valid
  late
  early_leave
  missing_checkout
  needs_review
}

enum PayrollStatus {
  draft
  reviewing
  approved
  published
  locked
}

enum AccountAdminRole {
  system_admin
  user
}

enum LicensePlan {
  standard
  professional
  enterprise
}

enum AccountLifecycleStatus {
  pending_activation
  active
  closed
}

enum PermissionGroupStatus {
  active
  archived
}

enum AdminSettingTier {
  system
  module
  operations
}

enum AdminSettingStatus {
  configured
  needs_review
  planned
}

enum DeviceAuthStatus {
  pending
  approved
  rejected
  locked
}

enum DepartmentStatus {
  active
  archived
}

enum JobCatalogStatus {
  active
  archived
}

model UserAccount {
  id                       String                 @id @default(uuid())
  keycloakUserId           String                 @unique
  email                    String                 @unique
  displayName              String
  employee                 Employee?
  roles                    String[]
  adminRole                AccountAdminRole       @default(user)
  licensePlan              LicensePlan            @default(standard)
  accountStatus            AccountLifecycleStatus @default(pending_activation)
  permissionGroupId        String?
  permissionGroup          PermissionGroup?       @relation(fields: [permissionGroupId], references: [id])
  customPermissionsEnabled Boolean                @default(false)
  customPermissions        Json?
  customPermissionNote     String?
  passwordResetRequired    Boolean                @default(false)
  temporaryPasswordIssuedAt DateTime?
  inviteEmailRequested     Boolean                @default(false)
  inviteSentAt             DateTime?
  activatedAt              DateTime?
  closedAt                 DateTime?
  preferences              UserPreference[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
}

model UserPreference {
  id        String      @id @default(uuid())
  accountId String
  account   UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  scope     String
  value     Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([accountId, scope])
  @@index([scope])
}

model PermissionGroup {
  id          String                @id @default(uuid())
  name        String                @unique
  description String
  roleScope   AccountAdminRole      @default(user)
  licensePlan LicensePlan           @default(standard)
  permissions String[]
  status      PermissionGroupStatus @default(active)
  archivedAt  DateTime?
  accounts    UserAccount[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model PermissionDefinition {
  key         String   @id
  category    String
  label       String
  description String?
  adminOnly   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminSetting {
  id        String             @id @default(uuid())
  key       String             @unique
  tier      AdminSettingTier
  module    String?
  category  String
  title     String
  summary   String
  owner     String
  status    AdminSettingStatus @default(planned)
  controls  String[]
  payload   Json?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model DeviceAuthPolicy {
  id                         String   @id @default("default")
  maxDevicesPerUser          Int      @default(1)
  requireNotificationEnabled Boolean  @default(true)
  requireGpsForAttendance    Boolean  @default(true)
  requireWifiForOffice       Boolean  @default(true)
  approvalRefreshHint        String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model DeviceAuthRequest {
  id           String           @id @default(uuid())
  employeeId   String?
  employee     Employee?        @relation(fields: [employeeId], references: [id])
  employeeCode String
  employeeName String
  avatar       String
  department   String
  branch       String
  deviceName   String
  deviceId     String           @unique
  submittedAt  DateTime
  status       DeviceAuthStatus @default(pending)
  lastUsedAt   DateTime?
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([employeeId])
  @@index([status])
}

model Employee {
  id                String             @id @default(uuid())
  code              String             @unique
  fullName          String
  title             String
  positionId        String?
  jobTitleId        String?
  status            EmployeeStatus     @default(active)
  startDate         DateTime
  officialStartDate DateTime?
  endDate           DateTime?
  employeeType      String?
  avatarUrl         String?
  attendanceCode    String?            @unique
  attendanceMode    String?
  payrollTemplate   String?
  standardWorkdays  Int?
  profileData       Json?
  userAccountId     String?            @unique
  departmentId      String
  managerId         String?
  userAccount       UserAccount?       @relation(fields: [userAccountId], references: [id])
  department        Department         @relation(fields: [departmentId], references: [id])
  position          JobPosition?       @relation(fields: [positionId], references: [id])
  jobTitle          JobTitle?          @relation(fields: [jobTitleId], references: [id])
  manager           Employee?          @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports     Employee[]         @relation("EmployeeManager")
  contracts         Contract[]
  documents         EmployeeDocument[]
  attendanceRecords AttendanceRecord[]
  attendanceRawLogs AttendanceRawLog[]
  leaveRequests     LeaveRequest[]
  payrollItems      PayrollItem[]
  assetAssignments  AssetAssignment[]
  deviceAuthRequests DeviceAuthRequest[]
  auditLogs         AuditLog[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([positionId])
  @@index([jobTitleId])
}

model Department {
  id                  String           @id @default(uuid())
  code                String           @unique
  name                String           @unique
  parentId            String?
  headId              String?
  permissionStructure String           @default("department")
  departmentType      String?
  businessUnit        String?
  description         String?
  isManagementUnit    Boolean          @default(false)
  status              DepartmentStatus @default(active)
  archivedAt          DateTime?
  parent              Department?      @relation("DepartmentTree", fields: [parentId], references: [id])
  children            Department[]     @relation("DepartmentTree")
  employees           Employee[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model EmployeeDocument {
  id         String   @id @default(uuid())
  employeeId String
  fieldName  String
  fileName   String
  mimeType   String
  size       Int
  content    Bytes
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([employeeId, fieldName])
}

model JobPosition {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String           @unique
  family      String?
  description String?
  status      JobCatalogStatus @default(active)
  archivedAt  DateTime?
  employees   Employee[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model JobTitle {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String           @unique
  rank        Int              @default(0)
  description String?
  status      JobCatalogStatus @default(active)
  archivedAt  DateTime?
  employees   Employee[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Contract {
  id         String    @id @default(uuid())
  employeeId String
  type       String
  startDate  DateTime
  endDate    DateTime?
  status     String
  fileUrl    String?
  employee   Employee  @relation(fields: [employeeId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Post {
  id          String     @id @default(uuid())
  authorId    String
  scope       PostScope
  title       String
  body        String
  requiresAck Boolean    @default(false)
  publishedAt DateTime?
  comments    Comment[]
  reactions   Reaction[]
  readMarks   PostReadMark[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  body      String
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reaction {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  emoji     String
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, userId, emoji])
}

model PostReadMark {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  readAt    DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])

  @@unique([postId, userId])
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  body        String
  audience    String
  publishedAt DateTime?
  readRate    Decimal   @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ApprovalRequest {
  id          String         @id @default(uuid())
  type        String
  requesterId String
  assigneeId  String?
  status      ApprovalStatus @default(pending)
  priority    String         @default("normal")
  payload     Json
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model AttendanceRecord {
  id         String           @id @default(uuid())
  employeeId String
  workDate   DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  source     String
  status     AttendanceStatus @default(valid)
  employee   Employee         @relation(fields: [employeeId], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([employeeId, workDate, source])
}

model AttendanceDevice {
  id         String             @id @default(uuid())
  deviceId   String             @unique
  deviceName String?
  storeCode  String?
  status     String             @default("active")
  lastSyncAt DateTime?
  rawLogs    AttendanceRawLog[]
  syncErrors AttendanceSyncError[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model AttendanceRawLog {
  id           String           @id @default(uuid())
  deviceId     String
  employeeId   String
  employeeCode String
  storeCode    String?
  punchTime    DateTime
  verifyType   String?
  rawPayload   Json?
  syncedAt     DateTime         @default(now())
  device       AttendanceDevice @relation(fields: [deviceId], references: [deviceId])
  employee     Employee         @relation(fields: [employeeId], references: [id])
  createdAt    DateTime         @default(now())

  @@unique([deviceId, employeeCode, punchTime])
  @@index([employeeId, punchTime])
}

model AttendanceSyncError {
  id           String            @id @default(uuid())
  deviceId     String
  employeeCode String?
  storeCode    String?
  punchTime    DateTime?
  errorType    String
  errorMessage String
  rawPayload   Json?
  device       AttendanceDevice  @relation(fields: [deviceId], references: [deviceId])
  createdAt    DateTime          @default(now())

  @@index([deviceId, createdAt])
  @@index([employeeCode, createdAt])
}

model LeaveRequest {
  id          String         @id @default(uuid())
  employeeId  String
  type        String
  fromDate    DateTime
  toDate      DateTime
  totalDays   Decimal
  reason      String?
  status      ApprovalStatus @default(pending)
  employee    Employee       @relation(fields: [employeeId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model PayrollCycle {
  id                 String        @id @default(uuid())
  name               String
  periodStart        DateTime
  periodEnd          DateTime
  status             PayrollStatus @default(draft)
  lockedAttendanceAt DateTime?
  items              PayrollItem[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model PayrollItem {
  id             String       @id @default(uuid())
  payrollCycleId String
  employeeId      String
  grossAmount     Decimal
  netAmount       Decimal
  currency        String       @default("VND")
  payload         Json
  payrollCycle    PayrollCycle @relation(fields: [payrollCycleId], references: [id])
  employee        Employee     @relation(fields: [employeeId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([payrollCycleId, employeeId])
}

model Objective {
  id          String   @id @default(uuid())
  ownerId     String
  cycle       String
  title       String
  progress    Decimal  @default(0)
  status      String
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TrainingCourse {
  id          String   @id @default(uuid())
  title       String
  ownerId     String
  startDate   DateTime
  endDate     DateTime?
  status      String
  enrollments TrainingEnrollment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TrainingEnrollment {
  id        String         @id @default(uuid())
  courseId  String
  learnerId String
  status    String
  score     Decimal?
  course    TrainingCourse @relation(fields: [courseId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([courseId, learnerId])
}

model Asset {
  id          String            @id @default(uuid())
  code        String            @unique
  name        String
  category    String
  status      String
  assignments AssetAssignment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model AssetAssignment {
  id         String    @id @default(uuid())
  assetId    String
  employeeId String
  assignedAt DateTime
  returnedAt DateTime?
  asset      Asset     @relation(fields: [assetId], references: [id])
  employee   Employee  @relation(fields: [employeeId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  event     String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String
  beforeValue Json?
  afterValue  Json?
  ipAddress   String?
  employee    Employee? @relation(fields: [actorId], references: [id])
  createdAt   DateTime @default(now())
}
