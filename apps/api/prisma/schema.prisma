generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeStatus {
  active
  onboarding
  offboarding
  resigned
}

enum ApprovalStatus {
  draft
  pending
  approved
  rejected
  cancelled
}

enum PostScope {
  company
  department
  group
  private
}

enum AttendanceStatus {
  valid
  late
  early_leave
  missing_checkout
  needs_review
}

enum PayrollStatus {
  draft
  reviewing
  approved
  published
  locked
}

enum AccountAdminRole {
  system_admin
  user
}

enum LicensePlan {
  standard
  professional
  enterprise
}

enum AccountLifecycleStatus {
  pending_activation
  active
  closed
}

enum PermissionGroupStatus {
  active
  archived
}

enum AdminSettingTier {
  system
  module
  operations
}

enum AdminSettingStatus {
  configured
  needs_review
  planned
}

enum DeviceAuthStatus {
  pending
  approved
  rejected
  locked
}

enum DepartmentStatus {
  active
  archived
}

enum JobCatalogStatus {
  active
  archived
}

model UserAccount {
  id                       String                 @id @default(uuid())
  keycloakUserId           String                 @unique
  email                    String                 @unique
  displayName              String
  employee                 Employee?
  roles                    String[]
  adminRole                AccountAdminRole       @default(user)
  licensePlan              LicensePlan            @default(standard)
  accountStatus            AccountLifecycleStatus @default(pending_activation)
  permissionGroupId        String?
  permissionGroup          PermissionGroup?       @relation(fields: [permissionGroupId], references: [id])
  // Per-account overrides of the group (AU-11), applied only while customPermissionsEnabled:
  // granted keys are added, revoked keys removed (revoke wins), and a scope set here replaces the
  // group's scope for that key.
  customPermissionsEnabled Boolean                @default(false)
  // Granted permission keys (string[]).
  customPermissions        Json?
  // Revoked permission keys (string[]).
  customRevokedPermissions Json?
  // { "<permission key>": "self" | "department" | "department_tree" | "branch" | "company" } for custom grants
  customPermissionScopes   Json?
  customPermissionNote     String?
  passwordResetRequired    Boolean                @default(false)
  temporaryPasswordIssuedAt DateTime?
  inviteEmailRequested     Boolean                @default(false)
  inviteSentAt             DateTime?
  activatedAt              DateTime?
  closedAt                 DateTime?
  // Access tokens issued before this instant are refused (AU-17 force logout), so signing an
  // account out takes effect at once instead of when its short-lived tokens expire.
  sessionsRevokedAt        DateTime?
  // Keycloak session ids (sid) signed out one by one (AU-16): [{ "sid": string, "at": ISO date }].
  // Kept only as long as a token of that session could still be valid.
  revokedSessionIds        Json?
  loginEvents              LoginEvent[]
  preferences              UserPreference[]
  auditLogs                AuditLog[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  uploadedFiles            StoredFile[]
  importJobs               ImportJob[]
  exportJobs               ExportJob[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
}

enum LoginOutcome {
  success
  invalid_credentials
  password_update_required
  account_not_linked
  account_inactive
}

// Sign-in attempts through the Helios login page (AU-20), reported by the web server with the
// browser's IP and user agent; Keycloak only sees the web server.
model LoginEvent {
  id             String        @id @default(uuid())
  accountId      String?
  account        UserAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  keycloakUserId String?
  username       String
  outcome        LoginOutcome
  // Keycloak session id (sid) of a successful sign-in; links GET /auth/sessions rows to their device.
  sessionId      String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([accountId, createdAt])
  @@index([sessionId])
}

enum ApprovalWorkflowStatus {
  draft
  active
  archived
}

model UserPreference {
  id        String      @id @default(uuid())
  accountId String
  account   UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  scope     String
  value     Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([accountId, scope])
  @@index([scope])
}

model PermissionGroup {
  id          String                @id @default(uuid())
  name        String                @unique
  description String
  roleScope   AccountAdminRole      @default(user)
  licensePlan LicensePlan           @default(standard)
  permissions String[]
  // Data scope per scopable permission key; see docs/design/data-scope.md
  permissionScopes Json                  @default("{}")
  status      PermissionGroupStatus @default(active)
  archivedAt  DateTime?
  accounts    UserAccount[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model PermissionDefinition {
  key         String   @id
  category    String
  label       String
  description String?
  adminOnly   Boolean  @default(false)
  // Scopable permissions are filtered by data scope (self ... company); others are yes/no only.
  scopable     Boolean @default(false)
  defaultScope String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminSetting {
  id        String             @id @default(uuid())
  key       String             @unique
  tier      AdminSettingTier
  module    String?
  category  String
  title     String
  summary   String
  owner     String
  status    AdminSettingStatus @default(planned)
  controls  String[]
  payload   Json?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model DeviceAuthPolicy {
  id                         String   @id @default("default")
  maxDevicesPerUser          Int      @default(1)
  requireNotificationEnabled Boolean  @default(true)
  requireGpsForAttendance    Boolean  @default(true)
  requireWifiForOffice       Boolean  @default(true)
  approvalRefreshHint        String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model DeviceAuthRequest {
  id           String           @id @default(uuid())
  employeeId   String?
  employee     Employee?        @relation(fields: [employeeId], references: [id])
  employeeCode String
  employeeName String
  avatar       String
  department   String
  branch       String
  deviceName   String
  deviceId     String           @unique
  submittedAt  DateTime
  status       DeviceAuthStatus @default(pending)
  lastUsedAt   DateTime?
  note         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([employeeId])
  @@index([status])
}

model Employee {
  id                String             @id @default(uuid())
  code              String             @unique
  fullName          String
  title             String
  positionId        String?
  jobTitleId        String?
  status            EmployeeStatus     @default(active)
  startDate         DateTime
  officialStartDate DateTime?
  endDate           DateTime?
  employeeType      String?
  avatarUrl         String?
  attendanceCode    String?            @unique
  attendanceMode    String?
  payrollTemplate   String?
  standardWorkdays  Int?
  profileData       Json?
  userAccountId     String?            @unique
  departmentId      String
  managerId         String?
  userAccount       UserAccount?       @relation(fields: [userAccountId], references: [id])
  department        Department         @relation(fields: [departmentId], references: [id])
  position          JobPosition?       @relation(fields: [positionId], references: [id])
  jobTitle          JobTitle?          @relation(fields: [jobTitleId], references: [id])
  manager           Employee?          @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports     Employee[]         @relation("EmployeeManager")
  contracts         Contract[]
  documents         EmployeeDocument[]
  attendanceRecords AttendanceRecord[]
  attendanceRawLogs AttendanceRawLog[]
  leaveRequests     LeaveRequest[]
  payrollItems      PayrollItem[]
  assetAssignments  AssetAssignment[]
  deviceAuthRequests DeviceAuthRequest[]
  auditLogs         AuditLog[]
  createdInternalPenalties InternalPenalty[] @relation("InternalPenaltyCreator")
  createdWelfareBenefits   WelfareBenefit[]   @relation("WelfareBenefitCreator")
  createdWelfarePackages   WelfarePackage[]   @relation("WelfarePackageCreator")
  followedApprovalWorkflows ApprovalWorkflowDefinition[] @relation("ApprovalWorkflowFollower")
  createdApprovalWorkflows  ApprovalWorkflowDefinition[] @relation("ApprovalWorkflowCreator")
  updatedApprovalWorkflows  ApprovalWorkflowDefinition[] @relation("ApprovalWorkflowUpdater")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([positionId])
  @@index([jobTitleId])
}

model Department {
  id                  String           @id @default(uuid())
  code                String           @unique
  name                String
  parentId            String?
  headId              String?
  permissionStructure String           @default("department")
  departmentType      String?
  businessUnit        String?
  description         String?
  isManagementUnit    Boolean          @default(false)
  status              DepartmentStatus @default(active)
  archivedAt          DateTime?
  parent              Department?      @relation("DepartmentTree", fields: [parentId], references: [id])
  children            Department[]     @relation("DepartmentTree")
  employees           Employee[]
  workplaces          Workplace[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([parentId, name])
}

enum StoredFileStatus {
  pending
  ready
  deleted
}

// A file kept in object storage (MinIO/S3). Business tables reference it by id; access is decided
// per purpose by a FileAccessPolicy. See docs/design/file-storage.md.
model StoredFile {
  id           String           @id @default(uuid())
  bucket       String
  objectKey    String           @unique
  fileName     String
  mimeType     String
  size         Int
  // Storage ETag after upload is confirmed.
  checksum     String?
  purpose      String
  ownerType    String?
  ownerId      String?
  status       StoredFileStatus @default(pending)
  uploadedById String?
  uploadedBy   UserAccount?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  employeeDocument EmployeeDocument?
  importJobs   ImportJob[]      @relation("ImportJobFile")
  exportJob    ExportJob?       @relation("ExportJobFile")
  createdAt    DateTime         @default(now())
  deletedAt    DateTime?

  @@index([ownerType, ownerId])
  @@index([status, createdAt])
}

model EmployeeDocument {
  id         String   @id @default(uuid())
  employeeId String
  fieldName  String
  fileName   String
  mimeType   String
  size       Int
  // Legacy rows kept the bytes in Postgres; new documents live in object storage (fileId).
  content    Bytes?
  fileId     String?     @unique
  file       StoredFile? @relation(fields: [fileId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([employeeId, fieldName])
}

enum ImportJobStatus {
  validating
  validated
  invalid
  committing
  committed
  failed
}

// One spreadsheet import (docs/design/import-export.md): the worker validates every row into
// `rows`/`errors`, the user reviews the preview, then commit writes the valid rows.
model ImportJob {
  id          String          @id @default(uuid())
  type        String
  status      ImportJobStatus @default(validating)
  fileId      String
  file        StoredFile      @relation("ImportJobFile", fields: [fileId], references: [id])
  createdById String
  createdBy   UserAccount     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  // Data scope of the creator when the job was created, reused by the worker.
  scope       Json
  totalRows   Int             @default(0)
  validRows   Int             @default(0)
  // [{ row, column?, message }]
  errors      Json?
  // Normalised valid rows: [{ row, data }]
  rows        Json?
  // Handler summary after commit, e.g. { created, updated }.
  result      Json?
  error       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  committedAt DateTime?

  @@index([createdById, createdAt])
}

enum ExportJobStatus {
  running
  ready
  failed
}

model ExportJob {
  id          String          @id @default(uuid())
  type        String
  status      ExportJobStatus @default(running)
  params      Json?
  scope       Json
  fileId      String?         @unique
  file        StoredFile?     @relation("ExportJobFile", fields: [fileId], references: [id])
  createdById String
  createdBy   UserAccount     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  rowCount    Int?
  error       String?
  createdAt   DateTime        @default(now())
  finishedAt  DateTime?

  @@index([createdById, createdAt])
}

model JobPosition {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String           @unique
  family      String?
  description String?
  status      JobCatalogStatus @default(active)
  archivedAt  DateTime?
  employees   Employee[]
  welfarePackages WelfarePackage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model JobTitle {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String           @unique
  rank        Int              @default(0)
  levelId     String?
  description String?
  status      JobCatalogStatus @default(active)
  archivedAt  DateTime?
  level       JobLevel?        @relation(fields: [levelId], references: [id], onDelete: SetNull)
  employees   Employee[]
  welfarePackages WelfarePackage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([levelId])
}

model JobLevel {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  sortOrder   Int              @default(0)
  status      JobCatalogStatus @default(active)
  archivedAt  DateTime?
  jobTitles   JobTitle[]
  welfarePackages WelfarePackage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Workplace {
  id                 String           @id @default(uuid())
  name               String           @unique
  addressLine        String?
  administrativeArea String?
  departmentId       String?
  description        String?
  status             JobCatalogStatus @default(active)
  archivedAt         DateTime?
  department         Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([departmentId])
}

model InternalPenalty {
  id          String           @id @default(uuid())
  violation   String
  amount      Int              @default(0)
  description String?
  status      JobCatalogStatus @default(active)
  archivedAt  DateTime?
  createdById String?
  createdBy   Employee?        @relation("InternalPenaltyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([createdById])
  @@index([status])
}

model WelfareBenefit {
  id          String           @id @default(uuid())
  name        String
  amount      Int              @default(0)
  description String?
  status      JobCatalogStatus @default(active)
  archivedAt  DateTime?
  createdById String?
  createdBy   Employee?        @relation("WelfareBenefitCreator", fields: [createdById], references: [id], onDelete: SetNull)
  packageItems WelfarePackageItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([createdById])
  @@index([status])
}

model WelfarePackage {
  id          String           @id @default(uuid())
  name        String
  startDate   DateTime?
  endDate     DateTime?
  positionId  String?
  jobTitleId  String?
  jobLevelId  String?
  description String?
  status      JobCatalogStatus @default(active)
  archivedAt  DateTime?
  createdById String?
  position    JobPosition?     @relation(fields: [positionId], references: [id], onDelete: SetNull)
  jobTitle    JobTitle?        @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  jobLevel    JobLevel?        @relation(fields: [jobLevelId], references: [id], onDelete: SetNull)
  createdBy   Employee?        @relation("WelfarePackageCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items       WelfarePackageItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([positionId])
  @@index([jobTitleId])
  @@index([jobLevelId])
  @@index([createdById])
  @@index([status])
}

model WelfarePackageItem {
  id            String          @id @default(uuid())
  packageId     String
  benefitId     String?
  amount        Int             @default(0)
  paymentMethod String?
  package       WelfarePackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  benefit       WelfareBenefit? @relation(fields: [benefitId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([packageId])
  @@index([benefitId])
}

model Contract {
  id         String    @id @default(uuid())
  employeeId String
  type       String
  startDate  DateTime
  endDate    DateTime?
  status     String
  fileUrl    String?
  employee   Employee  @relation(fields: [employeeId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Post {
  id          String     @id @default(uuid())
  authorId    String
  scope       PostScope
  title       String
  body        String
  requiresAck Boolean    @default(false)
  publishedAt DateTime?
  comments    Comment[]
  reactions   Reaction[]
  readMarks   PostReadMark[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  body      String
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reaction {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  emoji     String
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, userId, emoji])
}

model PostReadMark {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  readAt    DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])

  @@unique([postId, userId])
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  body        String
  audience    String
  publishedAt DateTime?
  readRate    Decimal   @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ApprovalRequest {
  id          String         @id @default(uuid())
  type        String
  requesterId String
  assigneeId  String?
  status      ApprovalStatus @default(pending)
  priority    String         @default("normal")
  payload     Json
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model AttendanceRecord {
  id         String           @id @default(uuid())
  employeeId String
  workDate   DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  source     String
  status     AttendanceStatus @default(valid)
  employee   Employee         @relation(fields: [employeeId], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([employeeId, workDate, source])
}

model ApprovalWorkflowDefinition {
  id                            String                 @id @default(uuid())
  code                          String?                @unique
  name                          String
  status                        ApprovalWorkflowStatus @default(active)
  objectType                    String
  subObject                     String                 @default("all")
  versionMode                   Boolean                @default(true)
  approvalType                  String                 @default("workflow")
  followerId                    String?
  showFlowInObject              Boolean                @default(false)
  allowAttachmentsAfterApproved Boolean                @default(false)
  allowDocumentChangesAfterApproved Boolean            @default(false)
  allowDiscussionAfterApproved Boolean                 @default(true)
  overdueAction                 String                 @default("none")
  flowDefinition                Json
  follower                      Employee?              @relation("ApprovalWorkflowFollower", fields: [followerId], references: [id], onDelete: SetNull)
  createdById                   String?
  createdBy                     Employee?              @relation("ApprovalWorkflowCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById                   String?
  updatedBy                     Employee?              @relation("ApprovalWorkflowUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt

  @@index([status])
  @@index([objectType])
  @@index([followerId])
  @@index([createdById])
  @@index([updatedById])
}

model AttendanceDevice {
  id         String             @id @default(uuid())
  deviceId   String             @unique
  deviceName String?
  storeCode  String?
  status     String             @default("active")
  lastSyncAt DateTime?
  rawLogs    AttendanceRawLog[]
  syncErrors AttendanceSyncError[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model AttendanceRawLog {
  id           String           @id @default(uuid())
  deviceId     String
  employeeId   String
  employeeCode String
  storeCode    String?
  punchTime    DateTime
  verifyType   String?
  rawPayload   Json?
  syncedAt     DateTime         @default(now())
  device       AttendanceDevice @relation(fields: [deviceId], references: [deviceId])
  employee     Employee         @relation(fields: [employeeId], references: [id])
  createdAt    DateTime         @default(now())

  @@unique([deviceId, employeeCode, punchTime])
  @@index([employeeId, punchTime])
}

model AttendanceSyncError {
  id           String            @id @default(uuid())
  deviceId     String
  employeeCode String?
  storeCode    String?
  punchTime    DateTime?
  errorType    String
  errorMessage String
  rawPayload   Json?
  device       AttendanceDevice  @relation(fields: [deviceId], references: [deviceId])
  createdAt    DateTime          @default(now())

  @@index([deviceId, createdAt])
  @@index([employeeCode, createdAt])
}

model LeaveRequest {
  id          String         @id @default(uuid())
  employeeId  String
  type        String
  fromDate    DateTime
  toDate      DateTime
  totalDays   Decimal
  reason      String?
  status      ApprovalStatus @default(pending)
  employee    Employee       @relation(fields: [employeeId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model PayrollCycle {
  id                 String        @id @default(uuid())
  name               String
  periodStart        DateTime
  periodEnd          DateTime
  status             PayrollStatus @default(draft)
  lockedAttendanceAt DateTime?
  items              PayrollItem[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model PayrollItem {
  id             String       @id @default(uuid())
  payrollCycleId String
  employeeId      String
  grossAmount     Decimal
  netAmount       Decimal
  currency        String       @default("VND")
  payload         Json
  payrollCycle    PayrollCycle @relation(fields: [payrollCycleId], references: [id])
  employee        Employee     @relation(fields: [employeeId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([payrollCycleId, employeeId])
}

model Objective {
  id          String   @id @default(uuid())
  ownerId     String
  cycle       String
  title       String
  progress    Decimal  @default(0)
  status      String
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TrainingCourse {
  id          String   @id @default(uuid())
  title       String
  ownerId     String
  startDate   DateTime
  endDate     DateTime?
  status      String
  enrollments TrainingEnrollment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TrainingEnrollment {
  id        String         @id @default(uuid())
  courseId  String
  learnerId String
  status    String
  score     Decimal?
  course    TrainingCourse @relation(fields: [courseId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([courseId, learnerId])
}

model Asset {
  id          String            @id @default(uuid())
  code        String            @unique
  name        String
  category    String
  status      String
  assignments AssetAssignment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model AssetAssignment {
  id         String    @id @default(uuid())
  assetId    String
  employeeId String
  assignedAt DateTime
  returnedAt DateTime?
  asset      Asset     @relation(fields: [assetId], references: [id])
  employee   Employee  @relation(fields: [employeeId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// In-app notification for one recipient account. See docs/design/notification.md.
model Notification {
  id             String      @id @default(uuid())
  accountId      String
  account        UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  event          String
  title          String
  body           String?
  // Path inside the web app that opens the related record.
  link           String?
  data           Json?
  actorAccountId String?
  readAt         DateTime?
  createdAt      DateTime    @default(now())

  @@index([accountId, readAt, createdAt])
}

// Per-account channel switches; event "*" is the account's default for every event.
model NotificationPreference {
  accountId String
  account   UserAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  event     String
  inApp     Boolean     @default(true)
  email     Boolean     @default(false)
  push      Boolean     @default(false)
  updatedAt DateTime    @updatedAt

  @@id([accountId, event])
}

// Catalog of notification events; defaults apply when an account has no preference.
model NotificationEventType {
  key          String  @id
  module       String
  label        String
  defaultEmail Boolean @default(false)
  // Users cannot turn these off (e.g. payslip published).
  mandatory    Boolean @default(false)
}

model AuditLog {
  id             String   @id @default(uuid())
  // Employee behind the action (null for accounts without an employee profile, e.g. admin).
  actorId        String?
  // Account that performed the action; always set for requests made by a signed-in user.
  actorAccountId String?
  actorAccount   UserAccount? @relation(fields: [actorAccountId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String
  beforeValue    Json?
  afterValue     Json?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  // "domain": written by a service with before/after values; "http": safety-net entry written by
  // AuditInterceptor for a mutation that recorded nothing itself.
  source         String   @default("domain")
  employee       Employee? @relation(fields: [actorId], references: [id])
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorAccountId])
}
